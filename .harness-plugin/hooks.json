{
  "capyhub-memory-and-confirm-guard": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/capy-session-guard.mjs --event SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/capy-session-guard.mjs --event PreInvocation",
        "timeout": 5
      }
    ]
  }
}
